/**
 * @fileoverview Firestore Security Rules for the Meny Back-Office application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model where each salesperson (user) can only access and modify data related to their own customers.
 *
 * Data Structure:
 * - /users/{userId}: Stores application user profiles.
 * - /users/{userId}/customerProfiles/{customerProfileId}: Stores customer profiles owned by a specific user.
 * - /users/{userId}/customerProfiles/{customerProfileId}/followUpActivities/{followUpActivityId}: Stores follow-up activities for a specific customer profile.
 * - /users/{userId}/customerProfiles/{customerProfileId}/taskReminders/{taskReminderId}: Stores task reminders for a specific customer profile.
 * - /users/{userId}/customerProfiles/{customerProfileId}/salesFunnelStatus: Stores the sales funnel status for a specific customer profile.
 *
 * Key Security Decisions:
 * - User listing is implicitly denied.
 * - All subcollections under /users/{userId} are strictly owned by that user.
 * - Data consistency between document IDs and paths is enforced on creation and updates.
 *
 * Denormalization for Authorization:
 * - The `customerId` field is denormalized into the `FollowUpActivity`, `TaskReminder` and `SalesFunnelStatus` documents to avoid `get()` calls for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles. Only the user themselves can read or modify their profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete): if request.auth.uid == userId
     * @deny (get, create, update, delete): if request.auth.uid != userId
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to customer profiles. Only the user (salesperson) who owns the customer profile can read or modify it.
     * @path /users/{userId}/customerProfiles/{customerProfileId}
     * @allow (get, list, create, update, delete): if request.auth.uid == userId
     * @deny (get, list, create, update, delete): if request.auth.uid != userId
     * @principle Enforces path-based ownership for all customer profile operations.
     */
    match /users/{userId}/customerProfiles/{customerProfileId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to follow-up activities. Only the user (salesperson) who owns the parent customer profile can read or modify these activities.
     * @path /users/{userId}/customerProfiles/{customerProfileId}/followUpActivities/{followUpActivityId}
     * @allow (get, list, create, update, delete): if request.auth.uid == userId
     * @deny (get, list, create, update, delete): if request.auth.uid != userId
     * @principle Enforces path-based ownership for all follow-up activity operations.
     */
    match /users/{userId}/customerProfiles/{customerProfileId}/followUpActivities/{followUpActivityId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to task reminders. Only the user (salesperson) who owns the parent customer profile can read or modify these reminders.
     * @path /users/{userId}/customerProfiles/{customerProfileId}/taskReminders/{taskReminderId}
     * @allow (get, list, create, update, delete): if request.auth.uid == userId
     * @deny (get, list, create, update, delete): if request.auth.uid != userId
     * @principle Enforces path-based ownership for all task reminder operations.
     */
    match /users/{userId}/customerProfiles/{customerProfileId}/taskReminders/{taskReminderId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to the sales funnel status. Only the user (salesperson) who owns the parent customer profile can read or modify the status.
     * @path /users/{userId}/customerProfiles/{customerProfileId}/salesFunnelStatus
     * @allow (get, create, update, delete): if request.auth.uid == userId
     * @deny (get, create, update, delete): if request.auth.uid != userId
     * @principle Enforces path-based ownership for all sales funnel status operations.
     */
    match /users/{userId}/customerProfiles/{customerProfileId}/salesFunnelStatus {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}